                          data-note="{{ tickerNotes[ticker] }}"
                          data-important="{{ tickerImportant[ticker] ? 'true' : 'false' }}"
                          data-check="{{ tickerCheck[ticker] ? 'true' : 'false' }}"
                          data-financials="{{ tickerFinancials[ticker] ? 'true' : 'false' }}"
