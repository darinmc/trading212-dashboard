                <th class="pl-percent-col" style="background-color: #f8f9fa; color: #333;">P/L (%)</th>
                <th class="pl-gbp-col" style="background-color: #f8f9fa; color: #333;">P/L (GBP)</th>
                <th class="separator-header"></th>
