                <td class="pl-gbp-col">{% set found = false %}{% for position in portfolioData.ISA.positions %}{% if position.ticker == ticker %}{% if position.profitLoss >= 0 %}<span class="pl-positive">▲ £{{ position.profitLoss|number_format(2) }}</span>{% else %}<span class="pl-negative">▼ £{{ position.profitLoss|number_format(2) }}</span>{% endif %}{% set found = true %}{% endif %}{% endfor %}{% if not found %}<span class="empty-cell">-</span>{% endif %}</td>
