                <td class="pl-percent-col">{% set found = false %}{% for position in portfolioData.SIPP.positions %}{% if position.ticker == ticker %}{% if position.profitLossPercent >= 0 %}<span class="pl-positive">▲ {{ position.profitLossPercent|number_format(2) }}%</span>{% else %}<span class="pl-negative">▼ {{ position.profitLossPercent|number_format(2) }}%</span>{% endif %}{% set found = true %}{% endif %}{% endfor %}{% if not found %}<span class="empty-cell">-</span>{% endif %}</td>
                <td class="pl-gbp-col">{% set found = false %}{% for position in portfolioData.SIPP.positions %}{% if position.ticker == ticker %}{% if position.profitLoss >= 0 %}<span class="pl-positive">▲ £{{ position.profitLoss|number_format(2) }}</span>{% else %}<span class="pl-negative">▼ £{{ position.profitLoss|number_format(2) }}</span>{% endif %}{% set found = true %}{% endif %}{% endfor %}{% if not found %}<span class="empty-cell">-</span>{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
<!-- SIPP Trade Modal -->
<div class="modal fade" id="sippTradeModal" tabindex="-1" aria-labelledby="sippTradeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="{{ path('app_sipp_trade') }}">
        <div class="modal-header">
          <h5 class="modal-title" id="sippTradeModalLabel">✍️ Record SIPP Trade</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        
        <!-- The white background wrapper starts here -->
        <div class="modal-body" style="background-color: #f8f9fa; color: #333; padding: 20px;">
          <div class="mb-3">
            <label class="form-label fw-bold">Ticker (e.g. BHL, EVTL)</label>
            <input type="text" name="ticker" class="form-control" required placeholder="Enter ticker" style="background: white;">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Action</label>
            <select name="type" class="form-select" style="background: white;">
              <option value="BUY">BUY</option>
              <option value="SELL">SELL</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Date</label>
            <input type="date" name="date" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required style="background: white;">
          </div>
                    <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label fw-bold">Shares</label>
              <input type="number" step="0.0001" name="shares" class="form-control" required style="background: white;">
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label fw-bold">Currency</label>
              <select name="currency" class="form-select" style="background: white;">
                <option value="GBP">GBP (£)</option>
                <option value="USD">USD ($)</option>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label fw-bold">Price per Share</label>
              <input type="number" step="0.0001" name="price" class="form-control" required style="background: white;">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Additional Fees (£)</label>
            <input type="number" step="0.01" name="fees" class="form-control" value="0" style="background: white;">
            <small class="text-muted">Enter FX or platform fees in GBP (e.g., 0.02)</small>
          </div>
        </div>
        <!-- The white background wrapper ends here -->

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Trade</button>
        </div>
      </form>
    </div>
  </div>
</div>






































































































































































































































































































































































































</div>

<script>
    document.getElementById('ticker-search').addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('.master-table tbody tr');

        rows.forEach(function(row) {
            const tickerCell = row.cells[0];
            if (tickerCell && tickerCell.textContent.trim() !== '') {
                const tickerText = tickerCell.textContent.toLowerCase();
                if (tickerText.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    });
</script>
{% endblock %}
