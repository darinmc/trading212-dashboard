{{ form_start(form) }}
    <div class="mb-3">
        <label class="fw-bold mb-1">Ticker Symbol</label>
        {{ form_widget(form.ticker, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mb-3">
        <label class="fw-bold mb-1">Company Name</label>
        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mb-3">
        <label class="fw-bold mb-1">Shares</label>
        {{ form_widget(form.shares, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mb-3">
        <label class="fw-bold mb-1">Average Buy Price</label>
        {{ form_widget(form.avgPrice, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mb-3">
        <label class="fw-bold mb-1">Current Price</label>
        {{ form_widget(form.currentPrice, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mb-3">
        <label class="fw-bold mb-1">Portfolio Account</label>
        {{ form_widget(form.portfolio, {'attr': {'class': 'form-control'}}) }}
    </div>
    
    <div class="mt-3" style="display: flex; gap: 10px;">
        <button class="btn btn-success">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}
