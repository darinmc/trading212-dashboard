{% extends 'base.html.twig' %}

{% block title %}Positions{% endblock %}

{% block body %}
<style>
    .modal { z-index: 10050 !important; }
    .modal-backdrop { z-index: 10040 !important; }
    .modal-dialog { pointer-events: auto !important; }

    /* Gradient Modal Styling */
    .modal-content {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
        border: none;
    }
    .modal-header {
        border-bottom: 1px solid rgba(255,255,255,0.2) !important;
        justify-content: center;
    }
    .modal-footer {
        border-top: 1px solid rgba(255,255,255,0.2) !important;
        justify-content: center;
    }
    .modal-body {
        background: #f8f9fa !important;
        color: #333 !important;
        border-radius: 4px;
        margin: 0 15px;
    }
    .modal-body label {
        color: #333 !important;
        font-weight: bold;
        font-size: 13px;
    }
    .modal-body .form-control, 
    .modal-body .form-select {
        background: white !important;
        color: #333 !important;
        border: 1px solid #ced4da !important;
    }
    .modal-title {
        color: white !important;
        font-size: 18px;
        width: 100%;
        text-align: center;
    }
    .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
        position: absolute;
        right: 15px;
    }
</style>

<div class="container mt-4">
    <h1>Positions</h1>

    <div class="mb-3">
        <a href="{{ path('app_position_new') }}" class="btn btn-primary">+ Add New Position</a>
        <a href="{{ path('app_master_dashboard') }}" class="btn btn-info">📊 Dashboard</a>
        <a href="{{ path('app_trade_history') }}" class="btn btn-outline-primary">📜 Trade History</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search by ticker or name..." value="{{ search }}">
                </div>
                <div class="col-md-3">
                    <select name="account" class="form-select">
                        <option value="">All Portfolios</option>
                        <option value="INVEST" {% if accountFilter == 'INVEST' %}selected{% endif %}>INVEST</option>
                        <option value="ISA" {% if accountFilter == 'ISA' %}selected{% endif %}>ISA</option>
                        <option value="SIPP" {% if accountFilter == 'SIPP' %}selected{% endif %}>SIPP</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a href="{{ path('app_position_index') }}" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span><strong>Total Current Value:</strong> £{{ totalCurrentValue|number_format(2) }}</span>
        <span><strong>Total P/L (GBP):</strong> 
            {% if totalPL >= 0 %}
                <span class="text-success">▲ £{{ totalPL|number_format(2) }}</span>
            {% else %}
                <span class="text-danger">▼ £{{ totalPL|number_format(2) }}</span>
            {% endif %}
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Ticker</th>
                    <th>Name</th>
                    <th class="text-end">Shares</th>
                    <th class="text-end">Avg Price</th>
                    <th class="text-end">Current Price</th>
                    <th class="text-end">Total Spent</th>
                    <th class="text-end">Current Value</th>
                    <th class="text-end">P/L (GBP)</th>
                    <th class="text-end">P/L (%)</th>
                    <th>Portfolio</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for position in positions %}
                <tr>
                    <td><strong>{{ position.ticker }}</strong></td>
                    <td>{{ position.name }}</td>
                    <td class="text-end">{{ position.shares|number_format(2) }}</td>
                    <td class="text-end">{{ position.avgPrice|number_format(4) }}</td>
                    <td class="text-end">{{ position.currentPrice|number_format(4) }}</td>
                    <td class="text-end">£{{ position.totalSpent|number_format(2) }}</td>
                    <td class="text-end">£{{ position.currentValue|number_format(2) }}</td>
                    <td class="text-end {% if position.profitLoss >= 0 %}text-success{% else %}text-danger{% endif %}">
                        {% if position.profitLoss >= 0 %}▲{% else %}▼{% endif %} £{{ position.profitLoss|abs|number_format(2) }}
                    </td>
                    <td class="text-end {% if position.profitLossPercent >= 0 %}text-success{% else %}text-danger{% endif %}">
                        {% if position.profitLossPercent >= 0 %}▲{% else %}▼{% endif %} {{ position.profitLossPercent|abs|number_format(2) }}%
                    </td>
                    <td>{{ position.portfolio.accountType }}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-info text-white" data-bs-toggle="modal" data-bs-target="#tradeModal{{ position.id }}">Trade</button>
                        <a href="{{ path('app_position_edit', {'id': position.id, 'search': search, 'account': accountFilter}) }}" class="btn btn-sm btn-warning">Edit</a>
                        
                        <!-- Trade Modal -->
                        <div class="modal fade" id="tradeModal{{ position.id }}" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form method="post" action="{{ path('app_position_manual_trade', {'id': position.id, 'search': search, 'account': accountFilter}) }}">
                                        <div class="modal-header">
                                            <h5 class="modal-title">✍️ Record SIPP Trade ({{ position.ticker }})</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="fw-bold">Type</label>
                                                <select name="type" class="form-select">
                                                    <option value="BUY">BUY</option>
                                                    <option value="SELL">SELL</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="fw-bold">Date</label>
                                                <input type="date" name="date" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="fw-bold">Shares</label>
                                                    <input type="number" step="0.0001" name="shares" class="form-control" required>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="fw-bold">Currency</label>
                                                    <select name="currency" class="form-select">
                                                        <option value="GBP">GBP (£)</option>
                                                        <option value="USD">USD ($)</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="fw-bold">Price</label>
                                                    <input type="number" step="0.0001" name="price" class="form-control" required>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="fw-bold">Additional Fees (£)</label>
                                                <input type="number" step="0.01" name="fees" class="form-control" value="0">
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-primary">Save Trade</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="11" class="text-center">No positions found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
