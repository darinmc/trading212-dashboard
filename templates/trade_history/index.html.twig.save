{% extends 'base.html.twig' %}

{% block title %}Trade History{% endblock %}

{% block body %}
<style>
    .badge-invest { background-color: #f39c12 !important; color: white; }
    .badge-isa { background-color: #3498db !important; color: white; }
    .badge-sipp { background-color: #f1c40f !important; color: #333; }
    .badge-buy { background-color: #17a2b8 !important; color: white; }
    .badge-sell { background-color: #dc3545 !important; color: white; }
    .badge-pl-positive { background-color: #28a745 !important; color: white; }
    .badge-pl-negative { background-color: #dc3545 !important; color: white; }
    .current-year-hint { font-size: 0.75rem; color: #6c757d; font-style: italic; }
    .preset-btn { font-size: 0.8rem; padding: 2px 8px; }
</style>

{# Floating Toast Notifications #}
<div style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 350px; text-align: center;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-lg toast-message" style="border-radius: 8px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger shadow-lg toast-message" style="border-radius: 8px;">
            {{ message }}
        </div>
    {% endfor %}
</div>

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>📜 Trade History</h1>
        <div>
            <form method="post" action="{{ path('app_trade_history_refresh') }}" style="display: inline-block;" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='⏳ Refreshing...';">
                <button type="submit" class="btn btn-success">🔄 Refresh from T212</button>
            </form>
            
        </div>
    </div>

    {# Tax Year Summary #}
    {% if taxYearSummary and taxYearSummary.taxYear %}
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <strong>📊 Tax Year Summary: {{ taxYearSummary.taxYear }}</strong>
                <small class="ms-2">(INVEST account only — ISA & SIPP are not subject to CGT)</small>
                {% if defaultedToCurrent %}
                    <span class="badge bg-light text-dark ms-2">Current Year (default)</span>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <small class="text-muted">Disposals</small>
                        <div class="h4">{{ taxYearSummary.disposals }}</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">Proceeds</small>
                        <div class="h4">£{{ taxYearSummary.proceeds|number_format(2) }}</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">Gains</small>
                        <div class="h4 text-success">£{{ taxYearSummary.grossGains|number_format(2) }}</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">Losses</small>
                        <div class="h4 text-danger">£{{ taxYearSummary.grossLosses|number_format(2) }}</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">Net Gain</small>
                        <div class="h4">£{{ taxYearSummary.realisedPl|number_format(2) }}</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">Taxable (after £3k)</small>
                        <div class="h4 {% if taxYearSummary.taxableGain > 0 %}text-danger{% else %}text-success{% endif %}">
                            £{{ taxYearSummary.taxableGain|number_format(2) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Filters #}
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3" id="filter-form">
                <div class="col-md-2">
                    <label class="form-label">Account <small class="text-muted">(INVEST / ISA / SIPP)</small></label>
                    <select name="account" class="form-select auto-filter">
                        <option value="">All Accounts</option>
                        <option value="INVEST" {% if account == 'INVEST' %}selected{% endif %}>Invest</option>
                        <option value="ISA" {% if account == 'ISA' %}selected{% endif %}>Stocks ISA</option>
                        <option value="SIPP" {% if account == 'SIPP' %}selected{% endif %}>SIPP Portfolio</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type <small class="text-muted">(BUY / SELL)</small></label>
                    <select name="type" class="form-select auto-filter">
                        <option value="">All Types</option>
                        <option value="BUY" {% if type == 'BUY' %}selected{% endif %}>Buy</option>
                        <option value="SELL" {% if type == 'SELL' %}selected{% endif %}>Sell</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ticker</label>
                    <input type="text" name="ticker" class="form-control" value="{{ ticker }}" placeholder="e.g. RNLSY">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tax Year <small class="text-muted">(e.g. 2025/26)</small></label>
                    <select name="tax_year" class="form-select auto-filter">
                        <option value="">All Years</option>
                        {% for year in availableTaxYears %}
                            <option value="{{ year }}" {% if taxYear == year %}selected{% endif %}>{{ year }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" name="date_from" class="form-control auto-filter" value="{{ dateFrom }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" name="date_to" class="form-control auto-filter" value="{{ dateTo }}">
                </div>

                {# Quick presets #}
                <div class="col-md-4">
                    <label class="form-label">Quick Range</label>
                    <div>
                        <button type="button" class="btn btn-outline-secondary preset-btn" onclick="setPreset('today')">Today</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" onclick="setPreset('7d')">Last 7 days</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" onclick="setPreset('30d')">Last 30 days</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" onclick="setPreset('month')">This month</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" onclick="setPreset('clear')">Clear dates</button>
                    </div>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filter</button>
                    <a href="{{ path('app_trade_history') }}" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    {# Page Summary #}
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <small class="text-muted">Showing</small>
                    <div class="h5 mb-0">{{ items|length }} of {{ total }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <small class="text-muted">Buys on page</small>
                    <div class="h5 mb-0">{{ pageSummary.buys }} (£{{ pageSummary.buyValue|number_format(2) }})</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <small class="text-muted">Sells on page</small>
                    <div class="h5 mb-0">{{ pageSummary.sells }} (£{{ pageSummary.sellValue|number_format(2) }})</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <small class="text-muted">Realised P/L on page</small>
                    <div class="h5 mb-0 {% if pageSummary.realisedPl >= 0 %}text-success{% else %}text-danger{% endif %}">
                        £{{ pageSummary.realisedPl|number_format(2) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Transactions Table #}
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'date', 'dir': sort == 'date' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Date {% if sort == 'date' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'account', 'dir': sort == 'account' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Account {% if sort == 'account' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'ticker', 'dir': sort == 'ticker' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Ticker {% if sort == 'ticker' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'type', 'dir': sort == 'type' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Type {% if sort == 'type' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th class="text-end"><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'shares', 'dir': sort == 'shares' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Shares {% if sort == 'shares' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th class="text-end"><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'price', 'dir': sort == 'price' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Price (GBP) {% if sort == 'price' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th class="text-end"><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'value', 'dir': sort == 'value' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Value (GBP) {% if sort == 'value' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                    <th class="text-end"><a href="{{ path('app_trade_history', app.request.query.all|merge({'sort': 'pl', 'dir': sort == 'pl' and dir == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-white">Realised P/L {% if sort == 'pl' %}{{ dir == 'ASC' ? '▲' : '▼' }}{% endif %}</a></th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                {% set tx = item.tx %}
                <tr>
                    <td>{{ tx.tradeDate ? tx.tradeDate|date('d M Y H:i') : '-' }}</td>
                    <td>
                        {% if tx.accountType == 'INVEST' %}
                            <span class="badge badge-invest">INVEST</span>
                        {% elseif tx.accountType == 'ISA' %}
                            <span class="badge badge-isa">ISA</span>
                        {% elseif tx.accountType == 'SIPP' %}
                            <span class="badge badge-sipp">SIPP</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ tx.accountType }}</span>
                        {% endif %}
                    </td>
                    <td><strong>{{ item.displayTicker }}</strong></td>
                    <td>
                        {% if tx.type == 'BUY' %}
                            <span class="badge badge-buy">BUY</span>
                        {% else %}
                            <span class="badge badge-sell">SELL</span>
                        {% endif %}
                    </td>
                    <td class="text-end">{{ tx.shares|number_format(4) }}</td>
                    <td class="text-end">{{ tx.pricePerShare|number_format(4) }}</td>
                    <td class="text-end">{{ tx.totalValue|number_format(2) }}</td>
                    <td class="text-end">
                        {% if tx.realisedPl is not null %}
                            {% if tx.realisedPl >= 0 %}
                                <span class="badge badge-pl-positive">+£{{ tx.realisedPl|number_format(2) }}</span>
                            {% else %}
                                <span class="badge badge-pl-negative">-£{{ (tx.realisedPl * -1)|number_format(2) }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center text-muted">No transactions found for these filters.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_trade_history', app.request.query.all|merge({'page': page - 1})) }}">← Prev</a>
                </li>

                {% set startPage = max(1, page - 3) %}
                {% set endPage = min(totalPages, page + 3) %}

                {% if startPage > 1 %}
                    <li class="page-item"><a class="page-link" href="{{ path('app_trade_history', app.request.query.all|merge({'page': 1})) }}">1</a></li>
                    {% if startPage > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                {% endif %}

                {% for p in startPage..endPage %}
                    <li class="page-item {% if p == page %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_trade_history', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}

                {% if endPage < totalPages %}
                    {% if endPage < totalPages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                    <li class="page-item"><a class="page-link" href="{{ path('app_trade_history', app.request.query.all|merge({'page': totalPages})) }}">{{ totalPages }}</a></li>
                {% endif %}

                <li class="page-item {% if page >= totalPages %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_trade_history', app.request.query.all|merge({'page': page + 1})) }}">Next →</a>
                </li>
            </ul>
        </nav>
    {% endif %}

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Auto-submit form when dropdowns and dates change
        const autoFilters = document.querySelectorAll('.auto-filter');
        autoFilters.forEach(function(el) {
            el.addEventListener('change', function() {
                document.getElementById('filter-form').submit();
            });
        });

        // Auto-dismiss toast notifications after 4 seconds
        const toasts = document.querySelectorAll('.toast-message');
        toasts.forEach(function(toast) {
            setTimeout(function() {
                toast.style.transition = 'opacity 0.5s ease';
                toast.style.opacity = '0';
                setTimeout(function() {
                    toast.remove();
                }, 500);
            }, 4000);
        });
    });

    function setPreset(preset) {
        const form = document.getElementById('filter-form');
        const from = form.querySelector('input[name="date_from"]');
        const to = form.querySelector('input[name="date_to"]');
        const taxYear = form.querySelector('select[name="tax_year"]');
        taxYear.value = '';

        const today = new Date();
        const formatDate = (d) => {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        if (preset === 'today') {
            from.value = formatDate(today);
            to.value = formatDate(today);
        } else if (preset === '7d') {
            const start = new Date(today);
            start.setDate(today.getDate() - 6);
            from.value = formatDate(start);
            to.value = formatDate(today);
        } else if (preset === '30d') {
            const start = new Date(today);
            start.setDate(today.getDate() - 29);
            from.value = formatDate(start);
            to.value = formatDate(today);
        } else if (preset === 'month') {
            const start = new Date(today.getFullYear(), today.getMonth(), 1);
            const end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            from.value = formatDate(start);
            to.value = formatDate(end);
        } else if (preset === 'clear') {
            from.value = '';
            to.value = '';
        }

        form.submit();
    }
</script>
{% endblock %}
