{% extends 'base.html.twig' %}

{% block title %}Sold Holdings{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>💤 Sold Holdings</h1>
        <a href="{{ path('app_master_dashboard') }}" class="btn btn-secondary">← Back to Dashboard</a>
    </div>

    <p class="text-muted">
        Positions you've sold. Notes are preserved here — they'll automatically re-link if you buy the same ticker again in Invest or ISA.
    </p>

    {% if totals.count == 0 %}
        <div class="alert alert-info">No sold positions yet.</div>
    {% else %}

        <div class="alert alert-secondary">
            <strong>{{ totals.count }}</strong> sold position{{ totals.count != 1 ? 's' : '' }} found.
        </div>

        {% for portfolioType, data in soldData %}
            <h3 class="mt-4">{{ portfolioType }} ({{ data.count }})</h3>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Name</th>
                        <th>Last Shares Held</th>
                        <th>Last Price</th>
                        <th>Sold Date</th>
                        <th>Notes</th>
                        <th>Flags</th>
                    </tr>
                </thead>
                <tbody>
                    {% for position in data.positions %}
                        <tr>
                            <td><strong>{{ position.ticker }}</strong></td>
                            <td>{{ position.name ?? '-' }}</td>
                            <td>{{ position.shares|number_format(2) }}</td>
                            <td>£{{ position.currentPrice|number_format(4) }}</td>
                            <td>
                                {% if position.soldDate %}
                                    {{ position.soldDate|date('d M Y') }}
                                {% else %}
                                    <em class="text-muted">Unknown</em>
                                {% endif %}
                            </td>
                            <td style="max-width: 300px; white-space: pre-wrap;">{{ position.note ?? '-' }}</td>
                            <td>
                                {% if position.important %}<span class="badge bg-danger">!</span>{% endif %}
                                {% if position.checkFlag %}<span class="badge bg-warning text-dark">✓</span>{% endif %}
                                {% if position.financials %}<span class="badge bg-info text-dark">£</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}

    {% endif %}

</div>
{% endblock %}
